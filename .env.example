# Garnet Cache Configuration
# Copy this file to .env and customize for your environment
# All variables are optional - uncomment and set as needed

# ============================================================================
# NETWORK SETTINGS
# ============================================================================
# GARNET_BIND=127.0.0.1                    # Bind address (default: 127.0.0.1)
# GARNET_PORT=6379                         # Port (default: 6379)
# GARNET_CLUSTER_ANNOUNCE_IP=              # Cluster announce IP
# GARNET_CLUSTER_ANNOUNCE_PORT=            # Cluster announce port
# GARNET_CLUSTER_ANNOUNCE_HOSTNAME=        # Cluster announce hostname
# GARNET_CLUSTER_ADDRESS=                  # Cluster peer address
# GARNET_CLUSTER_PORT=                     # Cluster peer port
# GARNET_CLUSTER_PREFERRED_ENDPOINT_TYPE=  # ip, hostname, unknown

# ============================================================================
# MEMORY SETTINGS
# ============================================================================
# GARNET_LOG_MEMORY_SIZE=128m              # Main log memory (total, not just log)
# GARNET_PAGE_SIZE=32m                     # Page size (power of 2, min 512)
# GARNET_PAGE_COUNT=                       # Number of pages (power of 2)
# GARNET_SEGMENT_SIZE=1g                   # Disk segment size
# GARNET_OBJECT_LOG_SEGMENT_SIZE=1g        # Object log segment size
# GARNET_INDEX_MEMORY_SIZE=16m             # Initial index size
# GARNET_INDEX_MAX_MEMORY_SIZE=64m         # Max index size (before LRU eviction)
# GARNET_MUTABLE_PERCENT=100               # % of log kept mutable (0-100)

# Native allocator (off-heap for large allocations)
# GARNET_USE_NATIVE_ALLOCATOR=false
# GARNET_USE_LEGACY_BUFFER_POOL=false
# GARNET_BUFFER_POOL_MEMORY_BUDGET=        # Buffer pool budget (e.g., 1g)

# Read cache (for read-heavy workloads)
# GARNET_ENABLE_READ_CACHE=false
# GARNET_READ_CACHE_MEMORY_SIZE=           # Read cache memory
# GARNET_READ_CACHE_PAGE_SIZE=             # Read cache page size
# GARNET_READ_CACHE_PAGE_COUNT=            # Read cache page count

# ============================================================================
# STORAGE TIER (DISK-BACKED) - For datasets larger than RAM
# ============================================================================
# GARNET_STORAGE_TIER=false                # Enable disk tier
# GARNET_LOG_DIR=                          # Storage directory (default: GARNET_CHECKPOINT_DIR)
# GARNET_CHECKPOINT_DIR=/config/garnet/checkpoints
# GARNET_COPY_READS_TO_TAIL=false          # Copy reads to log tail
# GARNET_RECOVER=false                     # Recover from checkpoint on start

# Disk tier limits (15 GB example)
# GARNET_SEGMENT_SIZE=1g                   # Each segment file size
# GARNET_COMPACTION_MAX_SEGMENTS=15        # Max segments (15 × 1g = 15 GB)
# GARNET_COMPACTION_FREQ=60                # Check every 60 seconds
# GARNET_COMPACTION_TYPE=Lookup            # Lookup, Shift, Scan, None
# GARNET_COMPACTION_FORCE_DELETE=true      # Delete segments immediately

# ============================================================================
# OBJECT STORE (Hashes, Lists, Sets, Sorted Sets)
# ============================================================================
# GARNET_DISABLE_OBJECTS=false             # Disable objects (saves memory)
# GARNET_PUB_SUB_PAGE_SIZE=1m              # Pub/sub page size

# ============================================================================
# PUB/SUB
# ============================================================================
# GARNET_DISABLE_PUB_SUB=false             # Disable pub/sub

# ============================================================================
# AOF (APPEND-ONLY FILE) - Durability
# ============================================================================
# GARNET_ENABLE_AOF=false                  # Enable AOF
# GARNET_AOF_MEMORY_SIZE=                  # AOF memory buffer
# GARNET_AOF_PAGE_SIZE=                    # AOF page size
# GARNET_AOF_SEGMENT_SIZE=1g               # AOF segment size
# GARNET_AOF_PHYSICAL_SUBLOG_COUNT=1       # Physical sublogs (1-4)
# GARNET_AOF_REPLAY_TASK_COUNT=1           # Replay tasks per sublog
# GARNET_AOF_COMMIT_FREQ=0                 # Commit freq ms (0=immediate, -1=manual)
# GARNET_AOF_COMMIT_WAIT=false             # Wait for commit before reply
# GARNET_AOF_SIZE_LIMIT=                   # Max AOF size (truncate when exceeded)
# GARNET_AOF_SIZE_LIMIT_ENFORCE_FREQ=      # Enforce frequency seconds

# ============================================================================
# COMPACTION
# ============================================================================
# GARNET_COMPACTION_FREQ=60                # Background compaction freq (seconds)
# GARNET_COMPACTION_TYPE=Lookup            # Lookup, Shift, Scan, None
# GARNET_COMPACTION_FORCE_DELETE=true      # Delete segments after compaction
# GARNET_COMPACTION_MAX_SEGMENTS=15        # Max segments before compaction
# GARNET_ENABLE_COMPACTION=false           # Enable compaction (sets freq=60)

# ============================================================================
# CHECKPOINTING
# ============================================================================
# GARNET_CHECKPOINT_FREQ=0                 # Auto-checkpoint frequency (0=disabled)
# GARNET_EXPIRED_OBJECT_COLLECTION_FREQ=0  # Expired object collection (seconds)

# ============================================================================
# LUA SCRIPTING
# ============================================================================
# GARNET_ENABLE_LUA=false                  # Enable Lua scripts
# GARNET_LUA_TRANSACTION_MODE=false        # Run Lua as transaction
# GARNET_LUA_MEMORY_MANAGEMENT_MODE=       # Native, Tracked, Managed
# GARNET_LUA_SCRIPT_MEMORY_LIMIT=          # Memory limit per script
# GARNET_LUA_SCRIPT_TIMEOUT=0              # Script timeout ms (0=disabled)
# GARNET_LUA_LOGGING_MODE=Enable           # Enable, Silent, Disable

# ============================================================================
# CLUSTER (Multi-node)
# ============================================================================
# GARNET_ENABLE_CLUSTER=false              # Enable cluster mode
# GARNET_CLEAN_CLUSTER_CONFIG=false        # Start with clean config
# GARNET_PARALLEL_MIGRATE_TASK_COUNT=      # Parallel migrate tasks (0-16384)
# GARNET_USE_SCAN_AHEAD_MIGRATION=false    # Scan ahead during migration
# GARNET_MIGRATION_PIPELINE_DEPTH=1        # Migration pipeline depth
# GARNET_MIGRATION_DELETE_BATCH_SIZE=256   # Delete batch size
# GARNET_GOSSIP_SAMPLE_PERCENT=10          # Gossip sample %
# GARNET_GOSSIP_DELAY=1                    # Gossip delay seconds
# GARNET_CLUSTER_TIMEOUT=15000             # Cluster timeout ms
# GARNET_FAILOVER_RESET_PRIMARY_TIMEOUT=60 # Failover reset timeout
# GARNET_CLUSTER_CONFIG_FLUSH_FREQ=0       # Config flush freq ms (-1=never, 0=immediate)

# ============================================================================
# AUTHENTICATION
# ============================================================================
# GARNET_AUTH_MODE=NoAuth                  # NoAuth, Password, Aad, ACL, AclWithAad
# GARNET_PASSWORD=                         # Password for Password auth
# GARNET_PROTECTED_MODE=true               # Protected mode
# GARNET_ACL_FILE=                         # ACL file path
# GARNET_MAX_DATABASES=16                  # Max logical databases (1-256)

# ============================================================================
# TLS/SSL
# ============================================================================
# GARNET_TLS_ENABLED=false                 # Enable TLS
# GARNET_TLS_CERT_FILE=                    # Cert file (.pfx, .pem, .crt)
# GARNET_TLS_CERT_PASSWORD=                # Cert password
# GARNET_TLS_CERT_SUBJECT_NAME=            # Cert subject name
# GARNET_TLS_CERT_REFRESH_FREQ=0           # Cert refresh freq seconds
# GARNET_TLS_CLIENT_CERT_REQUIRED=false    # Require client cert
# GARNET_TLS_SERVER_CERT_REQUIRED=false    # Require server cert
# GARNET_TLS_CERT_REVOCATION_MODE=NoCheck  # NoCheck, Online, Offline
# GARNET_TLS_HANDSHAKE_TIMEOUT=0           # Handshake timeout seconds
# GARNET_TLS_ISSUER_CERT_PATH=             # Issuer cert path

# ============================================================================
# LOGGING
# ============================================================================
# GARNET_LOG_LEVEL=Information             # Trace, Debug, Information, Warning, Error, Critical, None
# GARNET_QUIET_MODE=false                  # Quiet mode (no banner)
# GARNET_DISABLE_CONSOLE_LOGGER=false      # Disable console output
# GARNET_FILE_LOGGER=                      # File log path
# GARNET_LOGGING_FREQUENCY=0               # Logging frequency seconds
# GARNET_LATENCY_MONITOR=false             # Enable latency tracking
# GARNET_SLOWLOG_THRESHOLD=0               # Slowlog threshold microseconds (0=disabled)
# GARNET_SLOWLOG_MAX_ENTRIES=128           # Slowlog max entries

# ============================================================================
# THREAD POOL
# ============================================================================
# GARNET_THREAD_POOL_MIN_THREADS=          # Min worker threads (0=system default)
# GARNET_THREAD_POOL_MAX_THREADS=          # Max worker threads (0=system default)
# GARNET_THREAD_POOL_MIN_IO_THREADS=       # Min IO completion threads
# GARNET_THREAD_POOL_MAX_IO_THREADS=       # Max IO completion threads

# ============================================================================
# NETWORK
# ============================================================================
# GARNET_NETWORK_CONNECTION_LIMIT=-1       # Max connections (-1=unlimited)

# ============================================================================
# DEVICE/STORAGE BACKEND (Linux Native)
# ============================================================================
# GARNET_DEVICE_TYPE=Default               # Default, Native, RandomAccess, FileStream, AzureStorage, LocalMemory, Null
# GARNET_DEVICE_IO_BACKEND=Default         # Default, Libaio, Uring (io_uring)
# GARNET_DEVICE_COMPLETION_THREADS=4       # IO completion threads (1-64)
# GARNET_DEVICE_THROTTLE_LIMIT=0           # Max in-flight IOs (0=device default)
# GARNET_DEVICE_IO_CONTEXTS=0              # IO contexts/rings (0=device default)
# GARNET_DEVICE_QUEUE_DEPTH=0              # Per-ring queue depth (0=device default)
# GARNET_DEVICE_URING_SQPOLL=false         # io_uring SQPOLL
# GARNET_DEVICE_URING_SQPOLL_IDLE_MS=10000 # SQPOLL idle ms
# GARNET_DEVICE_AIO_MAX_DEVICES=32         # Max libaio devices

# ============================================================================
# REVIVIFICATION (MEMORY RECOVERY)
# ============================================================================
# GARNET_ENABLE_REVIVIFICATION=true        # Enable revivification (default on)
# GARNET_REVIV_BIN_RECORD_SIZES=           # Record sizes per bin (comma-separated)
# GARNET_REVIV_BIN_RECORD_COUNTS=          # Record counts per bin (comma-separated)
# GARNET_REVIV_FRACTION=0.1                # Fraction eligible for revivification
# GARNET_REVIV_SEARCH_NEXT_HIGHER_BINS=0   # Search next higher bins
# GARNET_REVIV_BIN_BEST_FIT_SCAN_LIMIT=0   # Best fit scan limit (0=first fit)
# GARNET_REVIV_IN_CHAIN_ONLY=false         # Revivify in chains only

# ============================================================================
# REPLICATION
# ============================================================================
# GARNET_MAIN_MEMORY_REPLICATION=false     # Main-memory replication
# GARNET_FAST_AOF_TRUNCATE=false           # Fast AOF truncate
# GARNET_ON_DEMAND_CHECKPOINT=false        # On-demand checkpoint
# GARNET_REPL_DISKLESS_SYNC=false          # Diskless replication
# GARNET_REPL_DISK_BASED_SYNC_CHUNK_SIZE=4m # Disk sync chunk size

# ============================================================================
# METRICS
# ============================================================================
# GARNET_METRICS_SAMPLING_FREQ=0           # Metrics sampling frequency

# ============================================================================
# CONFIG IMPORT/EXPORT
# ============================================================================
# GARNET_CONFIG_IMPORT_PATH=               # Import config from path
# GARNET_CONFIG_IMPORT_FORMAT=RedisConf    # GarnetConf, RedisConf
# GARNET_CONFIG_EXPORT_PATH=               # Export config to path
# GARNET_CONFIG_EXPORT_FORMAT=RedisConf    # GarnetConf, RedisConf

# ============================================================================
# EXAMPLE PRESETS (uncomment one)
# ============================================================================

# Small Home (2GB RAM, ~100K entries)
# GARNET_MEMORY_SIZE=256m
# GARNET_INDEX_SIZE=2m
# GARNET_INDEX_MAX_SIZE=8m

# Large Home (4GB RAM, ~1M entries)
# GARNET_MEMORY_SIZE=512m
# GARNET_INDEX_SIZE=16m
# GARNET_INDEX_MAX_SIZE=32m

# Mini PC 8GB RAM (recommended)
# GARNET_MEMORY_SIZE=2g
# GARNET_INDEX_SIZE=64m
# GARNET_INDEX_MAX_SIZE=256m
# GARNET_STORAGE_TIER=true
# GARNET_COMPACTION_MAX_SEGMENTS=15

# Enterprise (16GB+ RAM, millions of entries)
# GARNET_MEMORY_SIZE=8g
# GARNET_INDEX_SIZE=512m
# GARNET_INDEX_MAX_SIZE=2g
# GARNET_STORAGE_TIER=true
# GARNET_COMPACTION_MAX_SEGMENTS=50
# GARNET_ENABLE_READ_CACHE=true
# GARNET_READ_CACHE_MEMORY_SIZE=1g